# EasyAssist AI Environment Configuration

# Server Port
PORT=5000

# MongoDB Database Connection String (e.g. mongodb+srv://... or mongodb://localhost:27017/easyassist)
# Note: If left blank or connection fails, the app automatically runs in-memory with local fallback persistence!
MONGODB_URI=mongodb://localhost:27017/easyassist

# AI API Key (Google Gemini or OpenAI)
# If left blank, the app uses its built-in intelligent Simple Answer System engine for zero-friction hackathon demos!
AI_API_KEY=your_api_key_here

# AI Provider: gemini (default) or openai
AI_PROVIDER=gemini

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
